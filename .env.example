# ===== LLM（OpenAI 兼容接口，可接 DeepSeek / 通义千问 / 智谱 / Moonshot / OpenAI）=====
# offline = 不调用大模型，用规则路由 + 抽取式回答，保证无 Key 也能跑通全链路
AGRI_LLM_PROVIDER=offline
AGRI_LLM_BASE_URL=https://api.deepseek.com/v1
AGRI_LLM_MODEL=deepseek-chat
AGRI_LLM_API_KEY=
AGRI_LLM_TEMPERATURE=0.2

# ===== 向量化 =====
# auto: 有 sentence-transformers 用本地 BGE，有 API Key 用云端，否则降级为内置 TF-IDF
# api / local / tfidf
AGRI_EMBED_PROVIDER=auto
AGRI_EMBED_BASE_URL=https://api.siliconflow.cn/v1
AGRI_EMBED_MODEL=BAAI/bge-m3
AGRI_EMBED_API_KEY=

# ===== 检索与切分 =====
AGRI_CHUNK_STRATEGY=heading
AGRI_CHUNK_MAX_CHARS=420
AGRI_CHUNK_OVERLAP=80
AGRI_TOP_K=5
AGRI_USE_RERANK=true
